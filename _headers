# Allow caching of static assets (CSS, JS, images)
/*.css
  Cache-Control: public, max-age=3600

/*.js
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=86400

# Prevent caching of HTML files - always check for fresh version
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/contributor-portal.html
  Cache-Control: no-cache, no-store, must-revalidate

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate

# ── Overrides ──────────────────────────────────────────────────────────────
# These two blocks must stay at the BOTTOM of the file. Where two rules match
# the same request, Netlify serves the one it reaches last rather than the more
# specific one. Sitting above /*.js and /*.css, as they were, they lost: the
# live site was returning "public, max-age=3600" for farmington.js.
#
# That is what made the Tigers pages need a hard refresh. The HTML revalidates
# on every visit, so a deploy reached the browser immediately — but the script
# every Tigers page depends on did not. New page, hour-old script, and the
# first function the page called that the old script had never heard of threw
# before anything rendered. Both files are small; revalidating costs a 304.
/farmington.css
  Cache-Control: no-cache, no-store, must-revalidate

/farmington.js
  Cache-Control: no-cache, no-store, must-revalidate

# The three cards the Tigers pages are built from — the schedule table, the
# roster card and the standings table. Same reasoning as farmington.js: a page
# that loads a stale one of these throws before it renders.
/farmington-schedule.js
  Cache-Control: no-cache, no-store, must-revalidate

/farmington-roster.js
  Cache-Control: no-cache, no-store, must-revalidate

/farmington-standings.js
  Cache-Control: no-cache, no-store, must-revalidate

# The worker decides what every other file's caching means, so it is the one
# file that must never be served from cache itself.
#
# These match on the REQUESTED path, not on the file the rewrite lands on. The
# worker and manifest are only ever requested at /farmingtontigersnh/..., so
# rules naming /farmington-sw.js — as the first version of this block did —
# never fire at all: the request never has that path, and /*.js above was
# quietly caching the worker for an hour.
/farmingtontigersnh/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/javascript; charset=utf-8

/farmingtontigersnh/manifest.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# The file behind both, in case anything reaches it directly.
/farmington-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# ── The contributor portal ─────────────────────────────────────────────────
# Same trap as farmington.js above, and it bit the portal the same way.
#
# contributor-portal.html revalidates on every visit, so a deploy reaches the
# browser at once. These four did not: /*.js and /*.css near the top of this
# file were caching them for an hour. A contributor opening the portal got
# today's page running yesterday's scripts.
#
# What that looked like: the dashboard showed BASKETBALL schools in October,
# because an older coverage-gap.js worked the season out differently, and
# "Error loading games" where the page should have said no coverage assigned.
# The page was fine; the scripts behind it were an hour stale.
/js/coverage-gap.js
  Cache-Control: no-cache, no-store, must-revalidate

/js/seasons.js
  Cache-Control: no-cache, no-store, must-revalidate

/contributor-schedule.js
  Cache-Control: no-cache, no-store, must-revalidate

/contributor-schedule.css
  Cache-Control: no-cache, no-store, must-revalidate

# Same trap as the Tigers worker above, for the NEC Front Row app. /*.js at the
# top of this file was serving /frontrow/sw.js from cache for an hour, which
# means the app could keep running a retired worker after a deploy.
/frontrow/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/javascript; charset=utf-8

/frontrow/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
