# Prevent caching of HTML files - always check for fresh version
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/contributor-portal.html
  Cache-Control: no-cache, no-store, must-revalidate

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate

# Farmington Tigers shared files - always revalidate.
# Every Tigers page loads exactly these two, so new HTML served against an
# hour-old script breaks the whole site rather than one page. They are small;
# revalidating costs a 304.
/farmington.css
  Cache-Control: no-cache, no-store, must-revalidate

/farmington.js
  Cache-Control: no-cache, no-store, must-revalidate

# Allow caching of static assets (CSS, JS, images)
/*.css
  Cache-Control: public, max-age=3600

/*.js
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=86400
